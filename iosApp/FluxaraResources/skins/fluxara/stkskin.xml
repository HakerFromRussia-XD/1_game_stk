<?xml version="1.0" encoding="UTF-8"?>
<!-- Fluxara Drift iOS interface skin. The base skin supplies controls that
     are not part of the public iPhone flow; this file replaces its visual
     language for the entry experience. -->
<skin base_theme_name="Fluxara" variant_name="Drift" author="Fluxara Drift team" base_theme="classic">
    <element type="background" image="background.png" horizontal-cut="true" vertical-cut="true"/>

    <!-- Original, high-contrast touch cards: a wide 9-slice texture keeps
         their corners intact across the large and compact actions. -->
    <element type="button" state="neutral" image="action_card.png"
             left_border="136" right_border="136" top_border="136" bottom_border="136"
             hborder_out_portion="0" vborder_out_portion="0"/>
    <element type="button" state="focused" image="action_card.png"
             left_border="136" right_border="136" top_border="136" bottom_border="136"
             hborder_out_portion="0" vborder_out_portion="0"/>

    <!-- White, cool-toned typography replaces the inherited gold arcade UI. -->
    <color type="text" state="neutral" r="238" g="244" b="255" />
    <color type="text" state="focused" r="255" g="255" b="255" />
    <color type="brighttext" state="neutral" r="158" g="238" b="255" />
    <color type="credits_text" state="neutral" r="220" g="232" b="250" />
    <color type="emphasis_text" state="neutral" r="102" g="224" b="255" />
    <color type="emphasis_text" state="focused" r="158" g="238" b="255" />
    <color type="font" state="top" a="255" r="245" g="250" b="255" />
    <color type="font" state="bottom" a="255" r="137" g="220" b="255" />
    <color type="font" state="normal" a="255" r="232" g="242" b="255" />
</skin>

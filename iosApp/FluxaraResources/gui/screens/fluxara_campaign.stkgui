<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="0" y="0" width="100%" height="100%" layout="vertical-row">
        <spacer width="10" height="6%"/>
        <label width="74%" height="fit" align="center" text_align="center"
               raw_text="FLUXARA DRIFT"/>
        <spacer width="10" height="1%"/>
        <header width="74%" height="fit" align="center" text_align="center"
                raw_text="CAMPAIGN"/>
        <spacer width="10" height="2%"/>
        <label width="74%" height="fit" align="center" text_align="center"
               raw_text="YOUR CIRCUIT"/>
        <spacer width="10" height="3%"/>
        <!-- The campaign contains one curated circuit, presented as a card. -->
        <icon-button id="track-preview" width="74%" height="39%" align="center"
                     custom_ratio="1.77778"/>
        <spacer width="10" height="2%"/>
        <header id="track-name" width="74%" height="fit" align="center"
                text_align="center"/>
        <spacer width="10" height="2%"/>
        <label width="74%" height="fit" align="center" text_align="center"
               raw_text="Ready when you are."/>
        <spacer width="10" height="2%"/>
        <button id="choose" width="54%" height="13%" align="center"
                raw_text="Race setup"/>
        <spacer width="10" height="3%"/>
        <button id="back" width="42%" height="11%" align="center"
                raw_text="Back"/>
        <spacer width="10" height="4%"/>
    </div>
</stkgui>

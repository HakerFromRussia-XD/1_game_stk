<stkgui>
    <div x="0" y="0" width="100%" height="100%" layout="vertical-row">
        <spacer width="10" height="8%"/>
        <label width="82%" height="fit" align="center" text_align="center"
               raw_text="FLUXARA DRIFT"/>
        <spacer width="10" height="1%"/>
        <header width="82%" height="fit" align="center" text_align="center"
                raw_text="READY TO RACE"/>
        <spacer width="10" height="3%"/>
        <label width="68%" height="fit" align="center" text_align="center"
               raw_text="LOCAL ARCADE CAMPAIGN"/>

<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="0" y="0" width="100%" height="100%" layout="vertical-row">
        <spacer width="10" height="5%"/>
        <label width="74%" height="fit" align="center" text_align="center"
               raw_text="FLUXARA DRIFT"/>
        <spacer width="10" height="1%"/>
        <header width="74%" height="fit" align="center" text_align="center"
                raw_text="CHOOSE YOUR DRIVE"/>
        <spacer width="10" height="2%"/>
        <model id="kart-model" width="74%" height="40%" align="center"/>
        <spacer width="10" height="1%"/>
        <header id="kart-name" width="74%" height="fit" align="center"
                text_align="center"/>
        <spacer width="10" height="1%"/>
        <label id="kart-stats" width="82%" height="fit" align="center"
               text_align="center"/>
        <spacer width="10" height="3%"/>
        <div width="74%" height="15%" align="center" layout="horizontal-row">
            <button id="previous" width="28%" height="100%" align="center"
                    raw_text="Previous"/>
            <spacer width="4%" height="10"/>
            <button id="next" width="28%" height="100%" align="center"
                    raw_text="Next"/>
            <spacer width="4%" height="10"/>
            <button id="start" width="36%" height="100%" align="center"
                    raw_text="Start race"/>
        </div>
        <spacer width="10" height="3%"/>
        <button id="back" width="42%" height="11%" align="center"
                raw_text="Back"/>
        <spacer width="10" height="4%"/>
    </div>
</stkgui>

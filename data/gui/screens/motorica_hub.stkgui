<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="5%" y="2%" width="90%" height="96%" layout="vertical-row">
        <header id="hub_title" width="100%" height="10%" align="center"
                raw_text="Motorica Signal Lab"/>
        <label id="hub_subtitle" width="96%" height="6%" align="center"
               text_align="center" raw_text="Signal training"/>
        <spacer width="10" height="1%"/>
        <roundedbox width="94%" height="18%" align="center">
            <div x="3%" y="8%" width="94%" height="84%" layout="vertical-row">
                <label id="full_game_notice" width="100%" height="64%"
                       align="center" text_align="center" word_wrap="true"
                       raw_text="Open the full game through Motorica Start"/>
                <label id="device_notice" width="100%" height="36%"
                       align="center" text_align="center"
                       raw_text="No device connected"/>
            </div>
        </roundedbox>
        <spacer width="10" height="2%"/>
        <div width="96%" height="19%" align="center" layout="horizontal-row">
            <button id="precision" proportion="1" height="100%" raw_text="Precision"/>
            <spacer width="2%" height="10"/>
            <button id="reaction" proportion="1" height="100%" raw_text="Reaction"/>
            <spacer width="2%" height="10"/>
            <button id="signal_hold" proportion="1" height="100%" raw_text="Signal Hold"/>
        </div>
        <spacer width="10" height="2%"/>
        <div width="82%" height="13%" align="center" layout="horizontal-row">
            <button id="history" proportion="1" height="100%" raw_text="History"/>
            <spacer width="2%" height="10"/>
            <button id="controls" proportion="1" height="100%" raw_text="Controls"/>
        </div>
        <spacer width="10" height="2%"/>
        <div width="82%" height="13%" align="center" layout="horizontal-row">
            <button id="settings" proportion="1" height="100%" raw_text="Settings"/>
            <spacer width="2%" height="10"/>
            <button id="about" proportion="1" height="100%" raw_text="Open Source"/>
        </div>
        <spacer width="10" height="3%"/>
    </div>
</stkgui>
